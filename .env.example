# ─────────────────────────────────────────────────────────────────────
#  Rubico's secret keys - for reference.
#
#  You normally never need this file: paste your keys on the /setup page
#  and they're saved privately on your Railway volume. Anything you add
#  as a Railway "Variable" with these names works too, and takes priority.
#  (Developers running Rubico locally can copy this to .env.)
# ─────────────────────────────────────────────────────────────────────

# ── SET IN RAILWAY → VARIABLES ───────────────────────────────────────
# Protects every Rubico page. Your browser asks for it; any username works.
DASHBOARD_PASSWORD=
# The port Rubico listens on. Use 8080 and pick 8080 when generating the domain.
PORT=8080

# ── FILLED IN BY THE /setup PAGE ─────────────────────────────────────
# Claude: https://console.anthropic.com/settings/keys (add a little credit under Billing)
ANTHROPIC_API_KEY=
# Telegram: message @BotFather, send /newbot, paste the token (123456789:AAH...)
TELEGRAM_BOT_TOKEN=
# Your chat - set automatically when you press "link my chat" on /setup
TELEGRAM_CHAT_ID=

# Google: your own *Web application* OAuth client from https://console.cloud.google.com/auth/clients
# Redirect URI: https://<your-rubico-address>/setup/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monzo: https://developers.monzo.com -> New OAuth Client (Confidential)
# Redirect URL: https://<your-rubico-address>/setup/monzo/callback
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# Spotify: https://developer.spotify.com/dashboard -> Create app (Web API)
# Redirect URI: https://<your-rubico-address>/setup/spotify/callback
SPOTIFY_CLIENT_ID=
