# ─────────────────────────────────────────────────────────────────────
#  Rubico secrets. Copy this file to .env (setup.py does it for you).
#  .env is gitignored - it never leaves your computer. Never share it.
# ─────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────

# Claude writes your brief and answers your messages.
# Get one: https://console.anthropic.com/settings/keys  (add a little credit under Billing)
ANTHROPIC_API_KEY=

# Your Telegram bot. In Telegram, message @BotFather, send /newbot, follow
# the prompts, and paste the token it gives you (looks like 123456789:AAH...).
TELEGRAM_BOT_TOKEN=

# Which chat the bot talks to (yours). setup.py fills this in automatically
# after you press Start on your bot. The bot ignores every other chat.
TELEGRAM_CHAT_ID=

# ── OPTIONAL: Google (Gmail + Calendar) ──────────────────────────────
# Your OWN OAuth client from Google Cloud Console - setup.py walks you through it:
#   https://console.cloud.google.com/auth/clients  -> Create client -> Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OPTIONAL: Monzo (UK bank) ────────────────────────────────────────
# https://developers.monzo.com -> Clients -> New OAuth Client
#   Redirect URL: http://localhost:8085/monzo/callback   Confidentiality: Confidential
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# ── OPTIONAL: Spotify ────────────────────────────────────────────────
# https://developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:8888/callback   API: Web API
# Only the Client ID is needed (PKCE login - no secret to leak).
SPOTIFY_CLIENT_ID=

# ── OPTIONAL: Dashboard password ─────────────────────────────────────
# Only needed if you open the dashboard to other devices (dashboard.host in
# config.yaml). Your browser will ask for it; any username works.
DASHBOARD_PASSWORD=
